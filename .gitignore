# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
publish/
*.user
*.suo

# IDE
.vs/
.vscode/
.idea/
*.DotSettings.user

# macOS
.DS_Store

# NuGet
*.nupkg
packages/

# Test results
[Tt]est[Rr]esult*/
*.trx
coverage*.xml

# ROMs and savefiles: never in the repository, for obvious copyright reasons.
# Double protection: by extension everywhere, plus the whole roms/ folder.
*.gba
*.gb
*.gbc
*.nds
*.sav
*.sa1
*.ss[0-9]
*.state

roms/*
!roms/README.md

# Local configuration
appsettings.Local.json

# Generated by build/make-icns.sh during a release
build/*.icns

# Local agent/editor state
.claude/

# Python bytecode from running the tools
__pycache__/
*.pyc
