<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless diagnostic console. Validates the mGBA -> TCP -> parsing chain without
    involving the UI, and is the target of milestone M3. Since M6 it can also render the
    analysis and recommendation layers, so both can be checked against real hardware.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>upks</AssemblyName>
    <RootNamespace>UltimatePoKeSync.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The console is an executable, so its types are internal: the tests are the only
         thing outside it that has any business reaching in. -->
    <InternalsVisibleTo Include="UltimatePoKeSync.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimatePoKeSync.Analysis\UltimatePoKeSync.Analysis.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Contracts\UltimatePoKeSync.Contracts.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.GameData\UltimatePoKeSync.GameData.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.GameData.Learnsets\UltimatePoKeSync.GameData.Learnsets.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Providers.MGba\UltimatePoKeSync.Providers.MGba.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Providers.MelonDs\UltimatePoKeSync.Providers.MelonDs.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Parsing\UltimatePoKeSync.Parsing.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Session\UltimatePoKeSync.Session.csproj" />
  </ItemGroup>

</Project>
