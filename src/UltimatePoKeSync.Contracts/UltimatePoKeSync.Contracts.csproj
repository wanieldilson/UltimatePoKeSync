<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The architectural boundary. See D-006 in the decision log.

    This project defines WHAT an emulator must deliver (raw bytes + game identity)
    without knowing ANYTHING about how they were extracted or how they are
    interpreted. That is why it has, and must keep, zero dependencies: not on
    PKHeX, not on a specific emulator, not on a specific generation.
  -->

</Project>
