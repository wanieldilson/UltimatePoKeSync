<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UltimatePoKeSync.App.ViewModels"
        xmlns:views="using:UltimatePoKeSync.App.Views"
        xmlns:sys="using:System"
        x:Class="UltimatePoKeSync.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="UltimatePoKeSync"
        Icon="avares://UltimatePoKeSync/Assets/app-icon.png"
        Width="1440" Height="900"
        MinWidth="1180" MinHeight="820"
        Background="{StaticResource Ink}"
        WindowDecorations="Full">

  <Window.Resources>
    <!--
      A palette rather than Fluent's defaults. Three surface levels instead of one flat
      grey, all biased slightly to blue so the neutrals read as chosen; the accent is the
      same blue the type chart gives Water, which keeps the app and its subject in one
      family. Per-Pokémon colour comes from the type and is applied at the tile, so the
      chrome never competes with it.
    -->
    <Color x:Key="Surface0Color">#0E1116</Color>
    <SolidColorBrush x:Key="Surface0" Color="#0E1116" />
    <SolidColorBrush x:Key="Surface1" Color="#161A21" />
    <SolidColorBrush x:Key="Surface2" Color="#1E242C" />
    <SolidColorBrush x:Key="Surface3" Color="#28303A" />
    <SolidColorBrush x:Key="Line" Color="#262E39" />
    <SolidColorBrush x:Key="LegacyInk" Color="#E9EDF3" />
    <SolidColorBrush x:Key="LegacyInkMuted" Color="#94A0B0" />
    <SolidColorBrush x:Key="LegacyAccent" Color="#4C8DF6" />
    <SolidColorBrush x:Key="LegacyAccentSoft" Color="#1B2B45" />

    <DataTemplate x:Key="ChipTemplate" x:DataType="vm:TypeChip">
      <Border Background="{Binding Brush}" CornerRadius="999" Padding="10,3" Margin="0,0,6,6"
              ToolTip.Tip="{Binding Detail}">
        <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="ChipPanel">
      <WrapPanel />
    </ItemsPanelTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{StaticResource Surface0}" />
      <Setter Property="Foreground" Value="{StaticResource LegacyInk}" />
    </Style>

    <!-- Cards sit one level above the ground and carry a hairline, which is what stops a
         dark interface reading as one undifferentiated sheet. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource LegacyInkMuted}" />
      <Setter Property="LetterSpacing" Value="0.09" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource LegacyInkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource LegacyInkMuted}" />
    </Style>

    <Style Selector="TextBlock.numeric">
      <Setter Property="FontFeatures" Value="tnum" />
    </Style>

    <!-- Buttons: a quiet pill by default, filled only where the action is the point of
         the panel it sits in. -->
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource Body}" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource LegacyInk}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource LegacyInk}" />
    </Style>
    <!-- Rail cards provide all their own ink and colour. The legacy button hover otherwise
         paints a smaller Fluent rectangle over only part of the comic card. -->
    <Style Selector="Button.railcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface1}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource LegacyAccent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource LegacyAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5F9BF8" />
      <Setter Property="BorderBrush" Value="#5F9BF8" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- The profile is two named modes, not an on/off state, so it reads as a segmented
         control rather than as a switch whose meaning depends on which way it points. -->
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource LegacyInkMuted}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.segment.on">
      <Setter Property="Background" Value="{StaticResource LegacyAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="Foreground" Value="{StaticResource LegacyInk}" />
    </Style>
    <Style Selector="Button.segment.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5F9BF8" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.tile">
      <Setter Property="BorderBrush" Value="{StaticResource LegacyAccent}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.tile">
      <Setter Property="BorderBrush" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource LegacyAccent}" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
  </Window.Styles>
  <!--
    The shell: one bordered slab with a title bar, an identity header, a tab strip and a
    body split into the party rail and the content area. Nothing here scrolls; the content
    area does. See D-047.
  -->
  <Border CornerRadius="26" BorderThickness="4" Margin="12,10,22,24"
          BorderBrush="{StaticResource Ink}" Background="{StaticResource ShellBg}"
          BoxShadow="{StaticResource ShadowShell}" ClipToBounds="True">
    <Grid RowDefinitions="Auto,Auto,Auto,*">

      <!-- Identity header: who the app is, what it found, and which profile answers. -->
      <Border Grid.Row="1" Background="{StaticResource HeaderBg}"
              IsVisible="{Binding IsConnected}"
              BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,4">
        <Panel>
          <Border Background="{StaticResource HalftoneBold}" IsHitTestVisible="False" />
          <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="22,18">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <Border Width="58" Height="58" CornerRadius="29" Background="White"
                      BorderBrush="{StaticResource Ink}" BorderThickness="4"
                      BoxShadow="{StaticResource ShadowCard}" ClipToBounds="True">
                <Image Source="avares://UltimatePoKeSync/Assets/upsync-icon.png"
                       Width="52" Height="52" />
              </Border>
              <StackPanel Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="UltimatePoKeSync" Classes="display" FontSize="21"
                           Foreground="{StaticResource Accent}" />
                <TextBlock Text="{Binding IdentityLine}" Classes="mono" FontSize="11.5"
                           LetterSpacing="1.03" />
              </StackPanel>
            </StackPanel>

            <!-- Live pill. The dot blinks only while something is actually arriving. -->
            <Border Grid.Column="2" Classes="chip" Background="#153021" BorderThickness="3"
                    Padding="15,9" Margin="0,0,12,0" BoxShadow="{StaticResource ShadowChip}"
                    IsVisible="{Binding IsConnected}" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Ellipse Width="11" Height="11" Fill="{StaticResource Good}"
                         Stroke="{StaticResource Ink}" StrokeThickness="2">
                  <Ellipse.Styles>
                    <Style Selector="Ellipse">
                      <Style.Animations>
                        <Animation Duration="0:0:1.8" IterationCount="Infinite">
                          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                        </Animation>
                      </Style.Animations>
                    </Style>
                  </Ellipse.Styles>
                </Ellipse>
                <TextBlock Text="LIVE" Classes="strong" FontSize="13.5"
                           Foreground="#B6F5C6" />
              </StackPanel>
            </Border>

            <!-- Profile switch: two halves of one pill, the chosen half filled. -->
            <Border Grid.Column="3" BorderBrush="{StaticResource Ink}" BorderThickness="3"
                    CornerRadius="999" ClipToBounds="True" VerticalAlignment="Center"
                    BoxShadow="{StaticResource ShadowChip}">
              <StackPanel Orientation="Horizontal">
                <Button Content="Playthrough" Command="{Binding ChooseProfileCommand}" CommandParameter="playthrough"
                        Classes="segment" Classes.on="{Binding !IsCompetitive}" />
                <Button Content="Competitive" Command="{Binding ChooseProfileCommand}" CommandParameter="competitive"
                        Classes="segment" Classes.on="{Binding IsCompetitive}" />
              </StackPanel>
            </Border>
          </Grid>
        </Panel>
      </Border>

      <!-- Tab strip. The active tab is a bar pinned to the bottom edge, not a fill. -->
      <Border Grid.Row="2" Background="{StaticResource TabBg}"
              IsVisible="{Binding IsConnected}"
              BorderBrush="{StaticResource Ink}" BorderThickness="0,0,0,4" Padding="14,0">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
          <Button Classes="tab" Classes.on="{Binding IsPokemonTab}" Content="Pokémon"
                  Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:DashboardTab.Pokemon}" />
          <Button Grid.Column="1" Classes="tab" Classes.on="{Binding IsStatsTab}"
                  Content="Stats &amp; IV/EV"
                  Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:DashboardTab.Stats}" />
          <Button Grid.Column="2" Classes="tab" Classes.on="{Binding IsBuildTab}"
                  Content="Best set"
                  Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:DashboardTab.Build}" />
          <Button Grid.Column="3" Classes="tab" Classes.on="{Binding IsLearnsetTab}"
                  Content="Learnset"
                  Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:DashboardTab.Learnset}" />
          <Button Grid.Column="4" Classes="tab" Classes.on="{Binding IsTeamTab}"
                  Content="Team"
                  Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:DashboardTab.Team}" />
          <Button Grid.Column="5" Classes="tab" Classes.on="{Binding IsTeamHintsTab}"
                  Content="Team hints"
                  Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:DashboardTab.TeamHints}" />
          <Button Grid.Column="7" Classes="tab bridge" Classes.on="{Binding IsBridgeTab}"
                  Content="Bridge"
                  Command="{Binding ShowTabCommand}"
                  CommandParameter="{x:Static vm:DashboardTab.Bridge}" />
        </Grid>
      </Border>

      <!-- Body: a fixed party rail and the content area beside it. -->
      <Grid Grid.Row="3" ColumnDefinitions="286,*" IsVisible="{Binding IsConnected}">

        <Border Background="{StaticResource RailBg}" BorderBrush="{StaticResource Ink}"
                BorderThickness="0,0,4,0">
          <Grid RowDefinitions="Auto,*,Auto" Margin="16,20">

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <TextBlock Text="PARTY" Classes="display" FontSize="12.5"
                         LetterSpacing="1.5" Foreground="#8D86A6" />
              <TextBlock Grid.Column="1" Classes="mono" Foreground="{StaticResource TextFaint}"
                         Text="{Binding PartyCountText}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">

                <ItemsControl ItemsSource="{Binding Slots}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PokemonSlotViewModel">
                      <!--
                        A card per member. The slot number overhangs the top-left corner and
                        the status badge the top-right, both outside the card's own bounds,
                        which is why the whole thing sits in a Panel with margins rather than
                        in a StackPanel.
                      -->
                      <Button Width="250" Margin="0,0,0,3" Classes="railcard"
                              Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectSlotCommand}"
                              CommandParameter="{Binding}">
                        <!--
                          The transparent 250 px stage contains the overhangs. They still sit
                          9/11 px above the green card, but never leave the Button's bounds,
                          otherwise Avalonia's presenter clips them during the hover lift.
                        -->
                        <Panel>
                          <Border Classes="card" Background="{Binding TileBrush}"
                                  Margin="9,11,4,0"
                                  Opacity="{Binding CardOpacity}">
                            <Grid ColumnDefinitions="54,*" ColumnSpacing="11">
                              <Border Width="54" Height="54" CornerRadius="12"
                                      BorderBrush="{StaticResource Ink}" BorderThickness="3"
                                      Background="{StaticResource PanelSunkenDeep}"
                                      ClipToBounds="True">
                                <Panel>
                                  <TextBlock Text="{Binding Initials}" Classes="mono"
                                             FontSize="10" HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             IsVisible="{Binding !HasSprite}" />
                                  <Image Source="{Binding Sprite}" IsVisible="{Binding HasSprite}"
                                         RenderOptions.BitmapInterpolationMode="None"
                                         Stretch="Uniform" Margin="2" />
                                </Panel>
                              </Border>

                              <StackPanel Grid.Column="1" Spacing="5">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                  <TextBlock Text="{Binding DisplaySpeciesName}" Classes="strong"
                                             FontFamily="{StaticResource Body}" FontWeight="Black"
                                             FontSize="16" TextTrimming="CharacterEllipsis" />
                                  <TextBlock Grid.Column="1" Text="{Binding LevelText}"
                                             Classes="mono" FontSize="12" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding TypeChips}"
                                              IsVisible="{Binding ShowsBattleData}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Orientation="Horizontal" Spacing="5" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TypeChip">
                                      <Border Classes="chip" BorderThickness="2" Padding="8,2"
                                              Background="{Binding Brush}">
                                        <TextBlock Text="{Binding UpperType}" FontFamily="{StaticResource Body}"
                                                   FontWeight="Black" FontSize="10.5"
                                                   Foreground="#0D1A0C" />
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7"
                                      IsVisible="{Binding ShowsBattleData}">
                                  <Border Height="11" CornerRadius="999"
                                          Background="{StaticResource Ink}" Padding="2"
                                          VerticalAlignment="Center">
                                    <Border CornerRadius="999"
                                            Background="{StaticResource PanelSunkenDeep}"
                                            ClipToBounds="True">
                                      <Grid>
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="{Binding HpFilled}" />
                                          <ColumnDefinition Width="{Binding HpRemaining}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding HpBrush}" />
                                      </Grid>
                                    </Border>
                                  </Border>
                                  <TextBlock Grid.Column="1" Text="{Binding HpText}"
                                             Classes="mono" FontSize="10.5" />
                                </Grid>

                                <TextBlock Text="not hatched yet" Classes="mono" FontSize="10.5"
                                           IsVisible="{Binding IsEgg}" />
                              </StackPanel>
                            </Grid>
                          </Border>

                        <!-- Slot number, overhanging the corner. -->
                        <Border Width="26" Height="26" CornerRadius="13"
                                BorderBrush="{StaticResource Ink}" BorderThickness="3"
                                Background="{Binding SlotBadgeBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,2,0,0" IsHitTestVisible="False">
                          <TextBlock Text="{Binding SlotNumber}" Classes="display" FontSize="11"
                                     Foreground="{StaticResource TextOnAccent}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Status badge, tilted, on the other corner. -->
                        <Border Classes="chip" BorderThickness="3" Background="{Binding RailBadgeBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,0,13,0" Padding="9,3"
                                RenderTransform="rotate(4deg)"
                                IsVisible="{Binding HasRailBadge}" IsHitTestVisible="False">
                          <TextBlock Text="{Binding RailBadgeText}"
                                     Foreground="{Binding RailBadgeForeground}" FontSize="10" />
                        </Border>
                        </Panel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Free slots, said once rather than drawn five times. -->
                <Border CornerRadius="16" BorderThickness="3" Padding="13"
                        BorderBrush="{StaticResource EmptyOutline}"
                        IsVisible="{Binding HasEmptySlots}">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding EmptySlotsText}" Classes="mono"
                               LetterSpacing="0.66" />
                    <ItemsControl ItemsSource="{Binding EmptySlots}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="sys:Int32">
                          <Border Height="34" BorderThickness="3" CornerRadius="11"
                                  BorderBrush="{StaticResource EmptyOutline}"
                                  Margin="0,0,7,0" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Spacing="12" Margin="0,14,0,0">
              <!-- Team score, pinned to the bottom of the rail. -->
              <Panel IsVisible="{Binding HasTeam}">
                <Border Classes="panel" Padding="16,18,16,14" Background="{StaticResource Panel}">
                  <StackPanel Spacing="9">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom">
                      <TextBlock Text="{Binding StrengthScore}" Classes="display" FontSize="38"
                                 Foreground="{StaticResource Accent}" />
                      <TextBlock Text="{Binding StrengthMaximumText}" Classes="display"
                                 FontSize="15" Foreground="{StaticResource TextFaint}"
                                 VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>

                    <Border Height="14" CornerRadius="999"
                            Background="{StaticResource Ink}" Padding="3">
                      <Border CornerRadius="999" Background="{StaticResource PanelSunkenDeep}"
                              ClipToBounds="True">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding StrengthFilled}" />
                            <ColumnDefinition Width="{Binding StrengthRemaining}" />
                          </Grid.ColumnDefinitions>
                          <Border Background="{StaticResource ScoreFill}" />
                        </Grid>
                      </Border>
                    </Border>

                    <ItemsControl ItemsSource="{Binding WeakestRailFactors}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StrengthRow">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,3,0,0">
                            <TextBlock Text="{Binding Lost}" Classes="mono strong"
                                       Foreground="{Binding LostBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Explanation}"
                                       Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="badge">
                  <TextBlock Text="TEAM SCORE" />
                </Border>
              </Panel>

              <!-- The one thing not in the design: the sprites the app never ships. -->
              <Border Classes="card" Background="{StaticResource PanelAlt}"
                      IsVisible="{Binding CanOfferSprites}">
                <StackPanel Spacing="7">
                  <TextBlock Text="NO SPRITES YET" Classes="display" FontSize="11"
                             LetterSpacing="1.2" Foreground="{StaticResource TextMuted}" />
                  <TextBlock Text="27 MB, animated, every generation." Classes="muted"
                             FontSize="11.5" TextWrapping="Wrap" />
                  <Button Content="Download" Classes="ink"
                          Command="{Binding DownloadSpritesCommand}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Classes="card" Background="{StaticResource PanelAlt}"
                      IsVisible="{Binding IsDownloadingSprites}">
                <StackPanel Spacing="7">
                  <TextBlock Text="{Binding SpriteStatus}" Classes="mono" />
                  <ProgressBar Value="{Binding SpriteProgress}" Maximum="1" Height="6" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <!--
          The content area. One screen at a time; the rail and the header never move.
          The panels below are the previous dashboard, kept working while each screen is
          rebuilt to the design in turn.
        -->
        <Panel Grid.Column="1" Background="{StaticResource TabBg}">
          <Border Background="{StaticResource HalftoneBold}" IsHitTestVisible="False" />

          <ScrollViewer IsVisible="{Binding ShowsConnectedEmptyState}">
            <StackPanel MaxWidth="720" Margin="24,28" Spacing="16" HorizontalAlignment="Center">

    <!-- Connected, read, and carrying nothing. Distinct from not being connected, which
         is what this used to be indistinguishable from. -->
    <StackPanel Grid.Row="1" IsVisible="{Binding HasEmptyParty}" Spacing="10"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
      <TextBlock Text="No Pokémon in the party" FontSize="20" FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock Classes="muted" TextAlignment="Center"
                 Text="The bridge is connected and the save was read: there is simply nothing in the team yet. Catch or withdraw one and it appears here on its own." />
      <TextBlock Text="{Binding GameText}" Classes="caption" HorizontalAlignment="Center" />
    </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!--
            The Pokémon screen. Hero, then the two half-width panels, then what is coming.
            Everything is bound: the numbers in the design's mock are sample data.
          -->
          <ScrollViewer DataContext="{Binding CurrentSlot}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsPokemonTab}">
            <StackPanel Spacing="18" Margin="22,20">

              <!-- Hero, tinted by the primary type, with the halftone and a soft corner glow. -->
              <Border BorderBrush="{StaticResource Ink}" BorderThickness="4" CornerRadius="22"
                      Background="{Binding TileBrush}" BoxShadow="{StaticResource ShadowHero}"
                      ClipToBounds="True" Padding="22">
                <Panel>
                  <Border Background="{StaticResource Halftone}" IsHitTestVisible="False"
                          Margin="-22" />
                  <Ellipse Width="280" Height="280" Fill="#12FFFFFF" IsHitTestVisible="False"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="0,-92,-72,0" />

                  <Grid ColumnDefinitions="190,*" ColumnSpacing="24">
                    <Border Width="190" Height="190" CornerRadius="20"
                            BorderBrush="{StaticResource Ink}" BorderThickness="4"
                            Background="#3312200F" BoxShadow="{StaticResource ShadowSprite}"
                            VerticalAlignment="Top" ClipToBounds="True">
                      <Panel>
                        <Image Source="{Binding Sprite}" IsVisible="{Binding HasSprite}"
                               RenderOptions.BitmapInterpolationMode="None"
                               Stretch="Uniform" Margin="10" />
                        <TextBlock Text="{Binding Initials}" Classes="display" FontSize="34"
                                   Foreground="#3FFFFFFF" IsVisible="{Binding !HasSprite}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="12">
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="14">
                        <Panel VerticalAlignment="Center">
                          <TextBlock Text="{Binding UpperSpeciesName}" Classes="display"
                                     FontSize="46" Foreground="{StaticResource Ink}"
                                     RenderTransform="translate(4px,4px)" />
                          <TextBlock Text="{Binding UpperSpeciesName}" Classes="display"
                                     FontSize="46" Foreground="White" />
                        </Panel>
                        <Border Grid.Column="1" Classes="chip" BorderThickness="3" Padding="13,5"
                                Background="{StaticResource Accent}" VerticalAlignment="Center"
                                RenderTransform="rotate(-3deg)"
                                BoxShadow="{StaticResource ShadowChip}"
                                IsVisible="{Binding ShowsBattleData}">
                          <TextBlock Text="{Binding LevelBadge}" Classes="display" FontSize="15"
                                     Foreground="{StaticResource TextOnAccent}" />
                        </Border>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding TypeChips}"
                                      IsVisible="{Binding ShowsBattleData}"
                                      VerticalAlignment="Center">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TypeChip">
                              <Border Classes="chip" BorderThickness="3" Padding="12,4"
                                      Background="{Binding Brush}">
                                <TextBlock Text="{Binding UpperType}" FontSize="13"
                                           Foreground="#0D1A0C" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Column="4" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding SlotAndDexText}" Classes="mono"
                                     Foreground="{StaticResource HeroMuted}"
                                     HorizontalAlignment="Right" />
                          <TextBlock Text="{Binding PidText}" Classes="mono"
                                     Foreground="{StaticResource HeroMuted}"
                                     HorizontalAlignment="Right" />
                        </StackPanel>
                      </Grid>

                      <!-- The big HP bar: 24 px, 4 px ink, a vertical green gradient. -->
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"
                            IsVisible="{Binding ShowsBattleData}">
                        <Border Height="24" CornerRadius="999" Background="{StaticResource Ink}"
                                Padding="4" BoxShadow="{StaticResource ShadowChip}">
                          <Border CornerRadius="999" Background="#3312200F"
                                  ClipToBounds="True">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding HpFilled}" />
                                <ColumnDefinition Width="{Binding HpRemaining}" />
                              </Grid.ColumnDefinitions>
                              <Border Background="{StaticResource HeroHp}" />
                            </Grid>
                          </Border>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding HpText}" Classes="display"
                                   FontSize="20" Foreground="White" VerticalAlignment="Center" />
                      </Grid>

                      <!-- Four facts, each a bordered chip on a translucent black fill. -->
                      <ItemsControl ItemsSource="{Binding Facts}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:FactChip">
                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                                    CornerRadius="12" Background="#47000000" Padding="12,6"
                                    Margin="0,0,8,8">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource HeroMuted}" />
                                <TextBlock Text="{Binding Value}" FontSize="13"
                                           FontWeight="Black" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Grid>
                </Panel>
              </Border>

              <!-- Moves now, and what the type chart says, side by side. -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="18" IsVisible="{Binding ShowsBattleData}">
                <Panel>
                  <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="9" Margin="0,12,0,0">
                      <ItemsControl ItemsSource="{Binding MoveSlots}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MoveRow">
                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                                    CornerRadius="14" Background="{StaticResource PanelAltDeep}"
                                    Padding="12,10" Margin="0,0,0,9"
                                    Opacity="{Binding Fade}">
                              <Grid ColumnDefinitions="9,*,Auto" ColumnSpacing="11">
                                <Border Width="9" Height="34" CornerRadius="4"
                                        Background="{Binding Brush}"
                                        BorderBrush="{StaticResource Ink}" BorderThickness="2" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Name}" Classes="strong" FontSize="15" />
                                  <TextBlock Text="{Binding Detail}" Classes="muted"
                                             FontSize="11.5" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Pp}" Classes="mono"
                                           FontSize="12" Foreground="#CFC7E6"
                                           VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                  <Border Classes="badge" Background="{StaticResource Alert}">
                    <TextBlock Text="MOVES NOW" Foreground="#120607" />
                  </Border>
                </Panel>

                <Panel Grid.Column="1">
                  <Border Classes="panel" Padding="18">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                      <StackPanel Spacing="7" IsVisible="{Binding HasWeaknesses}">
                        <TextBlock Text="TAKES DOUBLE FROM" Classes="display" FontSize="11"
                                   LetterSpacing="1.3" Foreground="{StaticResource TextMuted}" />
                        <ItemsControl ItemsSource="{Binding Weaknesses}"
                                      ItemTemplate="{StaticResource InkChipTemplate}"
                                      ItemsPanel="{StaticResource ChipWrap}" />
                      </StackPanel>

                      <StackPanel Spacing="7" IsVisible="{Binding HasResistances}">
                        <TextBlock Text="SHRUGS OFF" Classes="display" FontSize="11"
                                   LetterSpacing="1.3" Foreground="{StaticResource TextMuted}" />
                        <ItemsControl ItemsSource="{Binding Resistances}"
                                      ItemTemplate="{StaticResource InkChipTemplate}"
                                      ItemsPanel="{StaticResource ChipWrap}" />
                      </StackPanel>

                      <StackPanel Spacing="7" IsVisible="{Binding HasImmunities}">
                        <TextBlock Text="TAKES NOTHING FROM" Classes="display" FontSize="11"
                                   LetterSpacing="1.3" Foreground="{StaticResource TextMuted}" />
                        <ItemsControl ItemsSource="{Binding Immunities}"
                                      ItemTemplate="{StaticResource InkChipTemplate}"
                                      ItemsPanel="{StaticResource ChipWrap}" />
                      </StackPanel>

                      <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                              CornerRadius="14" Background="{StaticResource PanelSunken}"
                              Padding="13,11" IsVisible="{Binding HasMatchupNote}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding MatchupNoteTitle}" Classes="strong"
                                     FontSize="13" Foreground="{StaticResource Accent}" />
                          <TextBlock Text="{Binding MatchupNote}" FontSize="13"
                                     Foreground="{StaticResource TextMuted}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Classes="badge" Background="{StaticResource Info}">
                    <TextBlock Text="MATCHUPS" Foreground="#06171A" />
                  </Border>
                </Panel>
              </Grid>

              <!-- Coming up: what it becomes, and what the next levels bring. -->
              <Panel IsVisible="{Binding HasProgress}">
                <Border Classes="panel" Padding="18">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="22" Margin="0,14,0,0">
                    <Border Grid.Column="0" BorderBrush="{StaticResource Ink}" BorderThickness="3"
                            CornerRadius="16" Background="{StaticResource PanelAlt}"
                            Padding="12,10" IsVisible="{Binding HasEvolution}">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="52" Height="52" BorderBrush="{StaticResource Ink}"
                                BorderThickness="3" CornerRadius="12"
                                Background="{StaticResource PanelSunkenDeep}">
                          <TextBlock Text="{Binding EvolutionSpeciesName}" Classes="mono"
                                     FontSize="8" TextTrimming="CharacterEllipsis"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" MaxWidth="190">
                          <TextBlock Text="{Binding EvolutionCountdown}" Classes="display"
                                     FontSize="17" Foreground="{StaticResource Accent}" />
                          <TextBlock Text="{Binding EvolutionSpeciesName}" Classes="strong"
                                     FontSize="15" />
                          <TextBlock Text="{Binding EvolutionNote}" Classes="muted" FontSize="11.5"
                                     TextWrapping="Wrap" IsVisible="{Binding HasEvolutionNote}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding UpcomingMoves}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:UpcomingMoveRow">
                          <Grid ColumnDefinitions="66,*,Auto,120" ColumnSpacing="12"
                                Margin="0,0,0,8" Opacity="{Binding Fade}">
                            <TextBlock Text="{Binding Level}" Classes="display" FontSize="13"
                                       Foreground="{StaticResource Accent}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="strong"
                                       FontSize="14" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Classes="chip" Background="{Binding Brush}"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding Type}" Foreground="#0D1A0C" />
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding Distance}" Classes="mono"
                                       VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
                <Border Classes="badge">
                  <TextBlock Text="COMING UP" />
                </Border>
              </Panel>
            </StackPanel>
          </ScrollViewer>

          <!-- Stats & IV/EV: first explain the current number, then luck, then training. -->
          <ScrollViewer DataContext="{Binding CurrentSlot}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsStatsTab}">
            <StackPanel Spacing="18" Margin="22,20,24,30">

              <Panel IsVisible="{Binding ShowsBattleData}">
                <Border Classes="panel" Padding="22,20">
                  <StackPanel Spacing="14" Margin="0,14,0,0">
                    <WrapPanel Orientation="Horizontal">
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                        <Border Width="16" Height="12" BorderBrush="{StaticResource Ink}"
                                BorderThickness="2" CornerRadius="3"
                                Background="{StaticResource StatFloor}" />
                        <TextBlock Text="floor (every Pokémon gets it)" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,6">
                        <Border Width="16" Height="12" BorderBrush="{StaticResource Ink}"
                                BorderThickness="2" CornerRadius="3"
                                Background="{StaticResource BaseStat}" />
                        <TextBlock Text="base" FontSize="12" Foreground="{StaticResource TextMuted}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="16" Height="12" BorderBrush="{StaticResource Ink}"
                                BorderThickness="2" CornerRadius="3"
                                Background="{StaticResource Info}" />
                        <TextBlock Text="IV (luck, fixed forever)" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="16" Height="12" BorderBrush="{StaticResource Ink}"
                                BorderThickness="2" CornerRadius="3"
                                Background="{StaticResource Accent}" />
                        <TextBlock Text="EV (training, yours to spend)" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="16" Height="12" BorderBrush="{StaticResource Ink}"
                                BorderThickness="2" CornerRadius="3"
                                Background="{StaticResource Alert}" />
                        <TextBlock Text="nature" FontSize="12"
                                   Foreground="{StaticResource TextMuted}" />
                      </StackPanel>
                    </WrapPanel>

                    <ItemsControl ItemsSource="{Binding StatSources}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StatSourceRow">
                          <Grid ColumnDefinitions="44,*,52,190" ColumnSpacing="12"
                                Margin="0,0,0,11">
                            <TextBlock Text="{Binding Name}" Classes="display" FontSize="13"
                                       Foreground="{StaticResource Lavender}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Height="26" CornerRadius="10"
                                    Background="{StaticResource Ink}" Padding="3">
                              <Border CornerRadius="7" Background="{StaticResource PanelSunkenDeep}"
                                      ClipToBounds="True">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding FlatWidth}" />
                                    <ColumnDefinition Width="{Binding BaseWidth}" />
                                    <ColumnDefinition Width="{Binding IvWidth}" />
                                    <ColumnDefinition Width="{Binding EvWidth}" />
                                    <ColumnDefinition Width="{Binding NatureWidth}" />
                                    <ColumnDefinition Width="{Binding RemainingWidth}" />
                                  </Grid.ColumnDefinitions>
                                  <Border Background="{StaticResource StatFloor}" />
                                  <Border Grid.Column="1" Background="{StaticResource BaseStat}" />
                                  <Border Grid.Column="2" Background="{StaticResource Info}" />
                                  <Border Grid.Column="3" Background="{StaticResource Accent}" />
                                  <Border Grid.Column="4" Background="{StaticResource Alert}"
                                          Opacity="{Binding NatureOpacity}"
                                          IsVisible="{Binding HasNatureContribution}" />
                                </Grid>
                              </Border>
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Current}" Classes="display"
                                       FontSize="16" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Breakdown}" Classes="mono"
                                       FontSize="11.5" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
                <Border Classes="badge">
                  <TextBlock Text="{Binding UpperSpeciesName, StringFormat='{}{0} · WHERE EACH STAT COMES FROM'}" />
                </Border>
              </Panel>

              <Grid ColumnDefinitions="1.15*,*" ColumnSpacing="18"
                    IsVisible="{Binding ShowsBattleData}">
                <Panel>
                  <Border Classes="panel" Background="{StaticResource IvPanel}" Padding="20">
                    <StackPanel Spacing="14" Margin="0,14,0,0">
                      <TextBlock Text="{Binding IndividualValueIntro}" FontSize="13.5"
                                 Foreground="{StaticResource IvText}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding IndividualValues}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:IvRow">
                            <StackPanel Spacing="7" Margin="0,0,9,0">
                              <Border Height="74" CornerRadius="12"
                                      Background="{StaticResource Ink}" Padding="3">
                                <Border CornerRadius="9" Background="{StaticResource IvWell}"
                                        ClipToBounds="True">
                                  <Grid>
                                    <Grid.RowDefinitions>
                                      <RowDefinition Height="{Binding Empty}" />
                                      <RowDefinition Height="{Binding Filled}" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="1" Background="{Binding FillBrush}" />
                                    <TextBlock Text="MAX" Classes="display" FontSize="10"
                                               Foreground="{StaticResource TextOnAccent}"
                                               HorizontalAlignment="Center" Margin="0,5,0,0"
                                               IsVisible="{Binding IsPerfect}" />
                                  </Grid>
                                </Border>
                              </Border>
                              <TextBlock Text="{Binding Label}" Classes="mono" FontSize="12"
                                         Foreground="{StaticResource IvText}"
                                         HorizontalAlignment="Center" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                              CornerRadius="14" Background="{StaticResource IvWell}"
                              Padding="13,11" IsVisible="{Binding HasIndividualValueNote}">
                        <StackPanel Spacing="5">
                          <TextBlock Text="READ IT LIKE THIS" Classes="strong" FontSize="13"
                                     Foreground="{StaticResource Accent}" />
                          <TextBlock Text="{Binding IndividualValueNote}" FontSize="13"
                                     Foreground="{StaticResource IvText}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Classes="badge" Background="{StaticResource Info}"
                          RenderTransform="rotate(-2deg)">
                    <TextBlock Text="IV — THE LUCK YOU WERE DEALT" />
                  </Border>
                </Panel>

                <Panel Grid.Column="1">
                  <Border Classes="panel" Background="{StaticResource EvPanel}" Padding="20">
                    <StackPanel Spacing="12" Margin="0,14,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding EffortValueTotalText}" Classes="display"
                                   FontSize="34" Foreground="{StaticResource Accent}" />
                        <TextBlock Text="{Binding EffortValueRemainingText}" Classes="mono"
                                   FontSize="13" Foreground="{StaticResource EvText}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4" />
                      </StackPanel>
                      <Border Height="16" CornerRadius="999"
                              Background="{StaticResource Ink}" Padding="3">
                        <Border CornerRadius="999" Background="{StaticResource EvTrough}"
                                ClipToBounds="True">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding EffortValueTotalFilled}" />
                              <ColumnDefinition Width="{Binding EffortValueTotalRemaining}" />
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource Accent}" />
                          </Grid>
                        </Border>
                      </Border>
                      <ItemsControl ItemsSource="{Binding EffortValues}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:EvRow">
                            <Grid ColumnDefinitions="40,*,76" ColumnSpacing="10"
                                  Margin="0,0,0,9">
                              <TextBlock Text="{Binding Name}" Classes="mono" FontSize="12"
                                         Foreground="{StaticResource EvText}"
                                         VerticalAlignment="Center" />
                              <Panel Grid.Column="1" Height="16">
                                <Border CornerRadius="999" Background="{StaticResource Ink}"
                                        Padding="3" IsVisible="{Binding !IsEmpty}">
                                  <Border CornerRadius="999" Background="{StaticResource EvTrough}"
                                          ClipToBounds="True">
                                    <Grid>
                                      <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Filled}" />
                                        <ColumnDefinition Width="{Binding Remaining}" />
                                      </Grid.ColumnDefinitions>
                                      <Border Background="{StaticResource Accent}" />
                                    </Grid>
                                  </Border>
                                </Border>
                                <Rectangle Stroke="{StaticResource EvEmpty}" StrokeThickness="3"
                                           StrokeDashArray="4,3" RadiusX="8" RadiusY="8"
                                           Fill="{StaticResource EvTrough}"
                                           IsVisible="{Binding IsEmpty}" />
                              </Panel>
                              <TextBlock Grid.Column="2" Text="{Binding ValueText}" Classes="mono"
                                         FontSize="12" Foreground="White"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                              CornerRadius="14" Background="{StaticResource EvTrough}"
                              Padding="13,12">
                        <StackPanel Spacing="5">
                          <TextBlock Text="WHAT TO FARM NEXT" Classes="strong" FontSize="13"
                                     Foreground="{StaticResource Accent}" />
                          <TextBlock Text="{Binding EffortValueFarmNote}" FontSize="13"
                                     Foreground="{StaticResource EvText}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                      <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                              CornerRadius="14" Background="{StaticResource BadBg}"
                              Padding="13,11" IsVisible="{Binding HasEffortValueWarning}">
                        <TextBlock Text="{Binding EffortValueWarning}" FontSize="13"
                                   Foreground="{StaticResource WarningText}" TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </Border>
                  <Border Classes="badge" Background="{StaticResource Accent}"
                          RenderTransform="rotate(2deg)">
                    <TextBlock Text="EV — THE PART YOU CONTROL" />
                  </Border>
                </Panel>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- Best set: compare the live catch to the engine's recommendation. -->
          <ScrollViewer DataContext="{Binding CurrentSlot}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsBuildTab}">
            <StackPanel Spacing="18" Margin="22,20,24,30"
                        IsVisible="{Binding HasRecommendation}">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Panel>
                  <TextBlock Text="{Binding UpperSpeciesName, StringFormat='{}{0} · THE SET IT WANTS'}"
                             Classes="display" FontSize="26"
                             Foreground="{StaticResource Ink}"
                             RenderTransform="translate(3px,3px)" />
                  <TextBlock Text="{Binding UpperSpeciesName, StringFormat='{}{0} · THE SET IT WANTS'}"
                             Classes="display" FontSize="26"
                             Foreground="White" />
                </Panel>
                <Border Classes="chip" BorderThickness="3" Padding="12,4"
                        Background="{StaticResource Accent}" RenderTransform="rotate(-2deg)">
                  <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ProfileText}"
                             FontSize="12.5" Foreground="{StaticResource TextOnAccent}" />
                </Border>
              </StackPanel>

              <Grid ColumnDefinitions="*,78,*" ColumnSpacing="14">
                <Border Classes="panel" Background="{StaticResource PanelAlt}" Padding="18">
                  <StackPanel Spacing="9">
                    <TextBlock Text="RIGHT NOW" Classes="display" FontSize="13"
                               LetterSpacing="1.3" Foreground="{StaticResource TextMuted}"
                               Margin="0,0,0,5" />
                    <ItemsControl ItemsSource="{Binding BuildComparisonRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BuildComparisonRow">
                          <Border Classes="compare-left" Classes.changed="{Binding IsDifferent}"
                                  Margin="0,0,0,9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                              <TextBlock Text="{Binding LeftLabel}" FontWeight="Bold"
                                         Foreground="{StaticResource TextMuted}" />
                              <TextBlock Grid.Column="1" Text="{Binding LeftValue}" Classes="strong"
                                         HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="8"
                            VerticalAlignment="Center">
                  <Border Width="60" Height="60" CornerRadius="30"
                          BorderBrush="{StaticResource Ink}" BorderThickness="4"
                          Background="{StaticResource Accent}"
                          BoxShadow="{StaticResource ShadowCard}">
                    <TextBlock Text="→" Classes="display" FontSize="26"
                               Foreground="{StaticResource TextOnAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="{Binding BuildChangeText}" Classes="mono" FontSize="11"
                             HorizontalAlignment="Center" TextAlignment="Center" />
                </StackPanel>

                <Border Grid.Column="2" Classes="panel" Background="{Binding TileBrush}"
                        Padding="18">
                  <StackPanel Spacing="9">
                    <TextBlock Text="RECOMMENDED" Classes="display" FontSize="13"
                               LetterSpacing="1.3" Foreground="{StaticResource HeroMuted}"
                               Margin="0,0,0,5" />
                    <ItemsControl ItemsSource="{Binding BuildComparisonRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BuildComparisonRow">
                          <Border Classes="compare-right" Classes.changed="{Binding IsDifferent}"
                                  Margin="0,0,0,9">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                              <TextBlock Text="{Binding RightLabel}" FontWeight="Bold"
                                         Foreground="{StaticResource HeroMuted}" />
                              <TextBlock Grid.Column="1" Text="{Binding RightValue}" Classes="strong"
                                         Foreground="{StaticResource PositiveText}"
                                         HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>

              <Panel>
                <Border Classes="panel" Padding="20">
                  <StackPanel Spacing="14" Margin="0,14,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                      <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                              CornerRadius="16" Background="{StaticResource BadBg}"
                              Padding="15" DataContext="{Binding CurrentNatureCard}">
                        <StackPanel Spacing="9">
                          <TextBlock Text="{Binding Heading}" Classes="display" FontSize="17"
                                     Foreground="{StaticResource NegativeText}" />
                          <ItemsControl ItemsSource="{Binding Modifiers}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="9" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:NatureModifierChip">
                                <Border Classes="chip" Background="{Binding Brush}" Padding="10,3">
                                  <TextBlock Text="{Binding Text}" FontSize="11.5"
                                             Foreground="{StaticResource TextOnAccent}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding Explanation}" FontSize="13"
                                     Foreground="{StaticResource WarningText}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>

                      <Border Grid.Column="1" BorderBrush="{StaticResource Ink}" BorderThickness="3"
                              CornerRadius="16" Background="{StaticResource GoodBg}"
                              Padding="15" DataContext="{Binding RecommendedNatureCard}">
                        <StackPanel Spacing="9">
                          <TextBlock Text="{Binding Heading}" Classes="display" FontSize="17"
                                     Foreground="{StaticResource PositiveText}" />
                          <ItemsControl ItemsSource="{Binding Modifiers}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="9" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:NatureModifierChip">
                                <Border Classes="chip" Background="{Binding Brush}" Padding="10,3">
                                  <TextBlock Text="{Binding Text}" FontSize="11.5"
                                             Foreground="{StaticResource TextOnAccent}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock Text="{Binding Explanation}" FontSize="13"
                                     Foreground="{StaticResource NatureGoodText}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </Grid>
                    <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                            CornerRadius="14" Background="{StaticResource PanelSunken}"
                            Padding="14,12">
                      <TextBlock FontSize="13" Foreground="{StaticResource TextMuted}"
                                 TextWrapping="Wrap"
                                 Text="Nature is fixed at capture. It cannot be trained away — this is advice for the next catch, not a task for this one. Everything else on this page can still change." />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Classes="badge" Background="{StaticResource Alert}">
                  <TextBlock Text="WHY THIS NATURE" />
                </Border>
              </Panel>

              <Panel>
                <Border Classes="panel" Padding="20">
                  <StackPanel Spacing="14" Margin="0,14,0,0">
                    <ItemsControl ItemsSource="{Binding BuildMoves}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BuildMoveRow">
                          <Panel Margin="0,0,12,12" Opacity="{Binding Fade}">
                            <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                                    CornerRadius="16" Background="{StaticResource PanelAltDeep}"
                                    Padding="13">
                              <Grid ColumnDefinitions="8,*" ColumnSpacing="12">
                                <Border Width="8" CornerRadius="4" Background="{Binding Brush}"
                                        BorderBrush="{StaticResource Ink}" BorderThickness="2" />
                                <StackPanel Grid.Column="1" Spacing="5">
                                  <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" Classes="strong" FontSize="16" />
                                    <Border Classes="chip" Background="{Binding RoleBrush}">
                                      <TextBlock Text="{Binding Role}" FontSize="10"
                                                 Foreground="{StaticResource TextOnAccent}" />
                                    </Border>
                                  </StackPanel>
                                  <TextBlock Text="{Binding Description}" FontSize="12.5"
                                             Foreground="{StaticResource TextMuted}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                              </Grid>
                            </Border>
                            <Rectangle Stroke="{StaticResource BaseStat}" StrokeThickness="3"
                                       StrokeDashArray="4,3" RadiusX="16" RadiusY="16"
                                       IsVisible="{Binding !IsObtainableNow}" />
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Spacing="10"
                                IsVisible="{Binding HasAlternatives}">
                      <TextBlock Text="TURNED DOWN" Classes="mono" FontSize="11.5"
                                 LetterSpacing="0.69" VerticalAlignment="Center" />
                      <ItemsControl ItemsSource="{Binding Alternatives}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:AlternativeMoveRow">
                            <Border Classes="chip" BorderThickness="3" Padding="11,4"
                                    BorderBrush="{StaticResource BaseStat}" Margin="0,0,8,8">
                              <TextBlock FontSize="12.5" Foreground="{StaticResource TextMuted}">
                                <Run Text="{Binding Name}" FontWeight="Black" />
                                <Run Text=" — " />
                                <Run Text="{Binding Reason}" />
                              </TextBlock>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Border>
                <Border Classes="badge" Background="{StaticResource Info}"
                        RenderTransform="rotate(2deg)">
                  <TextBlock Text="FOUR SLOTS, FOUR JOBS" />
                </Border>
              </Panel>
            </StackPanel>
          </ScrollViewer>

          <!-- Learnset: the live evolution path and per-game level-up timeline. -->
          <ScrollViewer DataContext="{Binding CurrentSlot}"
                        IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsLearnsetTab}">
            <StackPanel Spacing="18" Margin="22,20,24,30">
              <Panel IsVisible="{Binding HasEvolutionLine}">
                <Border Classes="panel" Padding="20">
                  <StackPanel Spacing="16" Margin="0,16,0,0">
                    <ItemsControl ItemsSource="{Binding EvolutionStages}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EvolutionStageRow">
                          <Grid ColumnDefinitions="58,220" Opacity="{Binding Opacity}">
                            <StackPanel IsVisible="{Binding ShowsArrow}" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Spacing="5">
                              <TextBlock Text="→" Classes="display" FontSize="24"
                                         Foreground="{StaticResource BaseStat}" />
                              <TextBlock Text="{Binding ArrowLabel}" Classes="mono" FontSize="11" />
                            </StackPanel>
                            <Border Grid.Column="1" Classes="evolution-stage"
                                    Classes.current="{Binding IsCurrent}">
                              <StackPanel Spacing="9" HorizontalAlignment="Center">
                                <Border Width="84" Height="84" BorderBrush="{StaticResource Ink}"
                                        BorderThickness="3" CornerRadius="14"
                                        Background="{StaticResource PanelSunkenDeep}"
                                        ClipToBounds="True">
                                  <Panel>
                                    <TextBlock Text="{Binding Initials}" Classes="mono" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !HasSprite}" />
                                    <Image Source="{Binding Sprite}" IsVisible="{Binding HasSprite}"
                                           RenderOptions.BitmapInterpolationMode="None"
                                           Stretch="Uniform" Margin="3" />
                                  </Panel>
                                </Border>
                                <TextBlock Text="{Binding SpeciesName}" Classes="display" FontSize="17"
                                           Foreground="{StaticResource Lavender}" />
                                <Border Classes="chip" Background="{StaticResource Accent}"
                                        IsVisible="{Binding IsCurrent}">
                                  <TextBlock Text="{Binding Distance}" FontSize="10.5"
                                             Foreground="{StaticResource TextOnAccent}" />
                                </Border>
                                <TextBlock Text="{Binding Distance}" Classes="mono" FontSize="11.5"
                                           IsVisible="{Binding !IsCurrent}" />
                              </StackPanel>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                            CornerRadius="14" Background="{StaticResource PanelSunken}"
                            Padding="14,12" IsVisible="{Binding HasHoldEvolutionNote}">
                      <TextBlock Text="{Binding HoldEvolutionNote}" FontSize="13"
                                 Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Classes="badge" Background="{StaticResource Accent}">
                  <TextBlock Text="EVOLUTION LINE" />
                </Border>
              </Panel>

              <Panel IsVisible="{Binding HasLearnsetTimeline}">
                <Border Classes="panel" Padding="20">
                  <ItemsControl ItemsSource="{Binding LearnsetTimeline}" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LearnsetTimelineRow">
                        <Grid ColumnDefinitions="60,34,*" ColumnSpacing="16" MinHeight="58"
                              Opacity="{Binding Fade}">
                          <TextBlock Text="{Binding Level}" Classes="mono" FontSize="13"
                                     Foreground="{StaticResource Lavender}" Margin="0,9,0,0" />
                          <Panel Grid.Column="1">
                            <Border Width="4" Background="{StaticResource BaseStat}"
                                    HorizontalAlignment="Center" Margin="0,15,0,-15" />
                            <Ellipse Width="{Binding DotSize}" Height="{Binding DotSize}"
                                     Fill="{Binding DotBrush}" Stroke="{StaticResource Ink}"
                                     StrokeThickness="3" HorizontalAlignment="Center"
                                     VerticalAlignment="Top" Margin="0,7,0,0" />
                          </Panel>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                      Margin="0,6,0,12" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Name}" Classes="strong" FontSize="14"
                                       VerticalAlignment="Center" />
                            <Border Classes="chip" Background="{Binding Brush}"
                                    IsVisible="{Binding !IsKnown}">
                              <TextBlock Text="{Binding Type}" FontSize="10.5"
                                         Foreground="{StaticResource TextOnAccent}" />
                            </Border>
                            <Border Classes="chip" Background="{StaticResource Accent}"
                                    IsVisible="{Binding IsNext}">
                              <TextBlock Text="TAKE IT" FontSize="10.5"
                                         Foreground="{StaticResource TextOnAccent}" />
                            </Border>
                            <TextBlock Text="{Binding StateText}" FontSize="12.5"
                                       Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                          </StackPanel>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>
                <Border Classes="badge" Background="{StaticResource Info}"
                        RenderTransform="rotate(2deg)">
                  <TextBlock Text="LEVEL-UP TIMELINE" />
                </Border>
              </Panel>
            </StackPanel>
          </ScrollViewer>

          <!-- Team: every battler's job, then the combined 17-type coverage wall. -->
          <ScrollViewer IsVisible="{Binding IsTeamTab}">
            <StackPanel Spacing="18" Margin="22,20,24,30">
              <StackPanel Orientation="Horizontal" Spacing="14">
                <Panel>
                  <TextBlock Text="THE WHOLE PARTY" Classes="display" FontSize="26"
                             Foreground="{StaticResource Ink}"
                             RenderTransform="translate(3px,3px)" />
                  <TextBlock Text="THE WHOLE PARTY" Classes="display" FontSize="26"
                             Foreground="White" />
                </Panel>
                <Border Classes="chip" BorderThickness="3" Padding="12,4"
                        Background="{StaticResource Alert}" RenderTransform="rotate(2deg)">
                  <TextBlock Text="{Binding TeamGapBadgeText}" FontSize="12.5"
                             Foreground="{StaticResource Ink}" />
                </Border>
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Slots}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PokemonSlotViewModel">
                    <Border Classes="panel" Background="{Binding TileBrush}" Padding="16"
                            Margin="0,0,16,16" RenderTransform="rotate(-0.3deg)"
                            Opacity="{Binding CardOpacity}">
                      <StackPanel Spacing="11">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding SpeciesName}" Classes="display" FontSize="19" />
                          <Border Grid.Column="1" Classes="chip" Background="{Binding SlotBadgeBrush}"
                                  Padding="10,3">
                            <TextBlock Text="{Binding LevelBadge}" FontSize="11"
                                       Foreground="{StaticResource TextOnAccent}" />
                          </Border>
                        </Grid>
                        <Border Height="96" BorderBrush="{StaticResource Ink}" BorderThickness="3"
                                CornerRadius="14" Background="{StaticResource PanelSunkenDeep}"
                                ClipToBounds="True">
                          <Panel>
                            <TextBlock Text="{Binding Initials}" Classes="mono" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasSprite}" />
                            <Image Source="{Binding Sprite}" IsVisible="{Binding HasSprite}"
                                   RenderOptions.BitmapInterpolationMode="None"
                                   Stretch="Uniform" Margin="3" />
                          </Panel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding TypeChips}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="5" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TypeChip">
                              <Border Classes="chip" Background="{Binding Brush}">
                                <TextBlock Text="{Binding UpperType}"
                                           Foreground="{StaticResource TextOnAccent}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding TeamAnalysisText}" FontSize="12.5"
                                   Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Panel>
                <Border Classes="panel" Padding="20">
                  <StackPanel Spacing="14" Margin="0,18,0,0">
                    <ItemsControl ItemsSource="{Binding TeamCoverageTiles}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="9" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CoverageTileRow">
                          <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                                  CornerRadius="11" Background="{Binding Background}"
                                  Padding="4,9" Margin="0,0,8,8">
                            <StackPanel HorizontalAlignment="Center">
                              <TextBlock Text="{Binding Type}" FontWeight="Black" FontSize="10.5"
                                         Foreground="{Binding Foreground}"
                                         HorizontalAlignment="Center" />
                              <TextBlock Text="{Binding State}" Classes="mono" FontSize="10.5"
                                         Foreground="{Binding Foreground}"
                                         HorizontalAlignment="Center" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border BorderBrush="{StaticResource Ink}" BorderThickness="3"
                            CornerRadius="14" Background="{StaticResource PanelSunken}"
                            Padding="14,12">
                      <TextBlock Text="{Binding TeamCoverageNote}" FontSize="13"
                                 Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Classes="badge" Background="{StaticResource Info}">
                  <TextBlock Text="COVERAGE WALL · 17 TYPES" />
                </Border>
              </Panel>
            </StackPanel>
          </ScrollViewer>

          <!-- Suggestions are a separate decision: Team diagnoses what is carried;
               Team hints says what can be caught at the selected story point. -->
          <ScrollViewer IsVisible="{Binding IsTeamHintsTab}">
            <views:TeamHintsView Margin="22,24,28,30" />
          </ScrollViewer>

          <!-- The seventh screen shares the shell while live. -->
          <ScrollViewer IsVisible="{Binding IsBridgeTab}">
            <views:BridgeView Margin="22,24,28,30" HorizontalAlignment="Left" />
          </ScrollViewer>

          <!-- The screens not yet rebuilt still show the previous panels. -->
          <Grid IsVisible="{Binding ShowsOldPanels}" Margin="22,20" ColumnDefinitions="*">
      <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
        <Panel>

          <!-- No selection: the whole party. -->
          <StackPanel Spacing="14" IsVisible="{Binding ShowTeamPanel}">

            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Team strength" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" FontSize="29" FontWeight="SemiBold" Classes="numeric"
                             Text="{Binding StrengthScore, StringFormat='{}{0}/100'}" />
                </Grid>
                <ProgressBar Value="{Binding StrengthScore}" Maximum="100" Height="6" />
                <TextBlock Text="{Binding StrengthHeadline}" Classes="muted" FontSize="13.5" />

                <ItemsControl ItemsSource="{Binding StrengthFactors}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StrengthRow">
                      <Grid ColumnDefinitions="150,70,*" Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13.5"
                                   Classes="muted numeric" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Explanation}" FontSize="13.5"
                                   Classes="muted" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding CanOfferSprites}">
              <StackPanel Spacing="8">
                <TextBlock Text="No sprites yet" Classes="section" />
                <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12.5"
                           Text="About 27 MB, animated, every generation. The team works without them." />
                <Button Content="Download sprites" Command="{Binding DownloadSpritesCommand}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </Border>

            <Border Classes="card" IsVisible="{Binding IsDownloadingSprites}">
              <StackPanel Spacing="8">
                <TextBlock Text="Downloading sprites" Classes="section" />
                <ProgressBar Value="{Binding SpriteProgress}" Maximum="1" Height="6" />
                <TextBlock Text="{Binding SpriteStatus}" Classes="caption" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Defending" Classes="section" />
                <TextBlock Text="Weak to" Classes="caption" />
                <ItemsControl ItemsSource="{Binding TeamWeaknesses}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                <TextBlock Text="Neutral" Classes="caption" />
                <ItemsControl ItemsSource="{Binding TeamNeutral}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                <TextBlock Text="Resisted" Classes="caption" />
                <ItemsControl ItemsSource="{Binding TeamResisted}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                <TextBlock Text="Immune" Classes="caption" IsVisible="{Binding HasTeamImmunities}" />
                <ItemsControl ItemsSource="{Binding TeamImmune}" IsVisible="{Binding HasTeamImmunities}"
                              ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Attacking" Classes="section" />
                <TextBlock Text="Hit super effectively" Classes="caption" />
                <TextBlock Text="nothing yet" Classes="muted" FontSize="12.5" Opacity="0.4"
                           IsVisible="{Binding !HasSuperEffective}" />
                <ItemsControl ItemsSource="{Binding TeamSuperEffective}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                <TextBlock Text="No super-effective answer" Classes="caption" />
                <TextBlock Text="every type is covered" Classes="muted" FontSize="12.5" Opacity="0.4"
                           IsVisible="{Binding !HasUnanswered}" />
                <ItemsControl ItemsSource="{Binding TeamUnanswered}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
              </StackPanel>
            </Border>

          </StackPanel>

          <!-- A slot is selected: the Pokémon, the way a Pokédex would lay it out. -->
          <ContentControl IsVisible="{Binding !ShowTeamPanel}" Content="{Binding SelectedSlot}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:PokemonSlotViewModel">
                <StackPanel Spacing="14">

                  <!-- Hero: the sprite at a size worth looking at, tinted with the
                       Pokémon's own type so each one feels like its own page. -->
                  <Border CornerRadius="12" Padding="20" Background="{Binding TileBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Panel Width="112" Height="112" VerticalAlignment="Top">
                        <Border CornerRadius="10" Background="{Binding PrimaryBrush}"
                                IsVisible="{Binding !HasSprite}">
                          <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                     FontSize="33" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Sprite}" IsVisible="{Binding HasSprite}"
                               RenderOptions.BitmapInterpolationMode="None" Stretch="Uniform" />
                      </Panel>

                      <StackPanel Grid.Column="1" Margin="20,2,0,0" Spacing="9">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding SpeciesName}" FontSize="29" FontWeight="Bold" />
                          <TextBlock Text="{Binding NicknameText}" IsVisible="{Binding HasNickname}"
                                     Classes="muted" FontSize="14.5" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ItemsControl ItemsSource="{Binding TypeChips}"
                                        ItemTemplate="{StaticResource ChipTemplate}"
                                        ItemsPanel="{StaticResource ChipPanel}" />
                          <TextBlock Text="✦ shiny" IsVisible="{Binding IsShiny}" FontSize="12.5"
                                     Foreground="#C9A227" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid ColumnDefinitions="220,Auto,Auto" ColumnSpacing="10"
                              IsVisible="{Binding ShowsBattleData}">
                          <Grid Height="8" Width="220" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding HpFilled}" />
                              <ColumnDefinition Width="{Binding HpRemaining}" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="{Binding HpBrush}" />
                            <Border Grid.Column="1" CornerRadius="4" Opacity="0.25"
                                    Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding HpText}" FontSize="13.5"
                                     Classes="numeric" VerticalAlignment="Center" />
                          <Border Grid.Column="2" Background="{Binding StatusBrush}" CornerRadius="3"
                                  Padding="6,1" IsVisible="{Binding HasStatus}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11.5"
                                       FontWeight="SemiBold" />
                          </Border>
                        </Grid>

                        <TextBlock Classes="caption" IsVisible="{Binding ShowsBattleData}">
                          <Run Text="{Binding LevelText}" />
                          <Run Text="·" />
                          <Run Text="{Binding NatureName}" />
                          <Run Text="·" />
                          <Run Text="{Binding AbilityText}" />
                          <Run Text="·" />
                          <Run Text="{Binding HeldItemText}" />
                        </TextBlock>
                      </StackPanel>

                      <Button Grid.Column="2" Content="Back to team" VerticalAlignment="Top"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearSelectionCommand}" />
                    </Grid>
                  </Border>

                  <!-- What the next few levels bring. Above the best set on purpose: it is
                       the decision a player in the middle of a story is actually making. -->
                  <Border Classes="card" IsVisible="{Binding HasProgress}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Coming up" Classes="section" />

                      <StackPanel Spacing="3" IsVisible="{Binding HasEvolution}">
                        <TextBlock Text="{Binding EvolutionText}" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EvolutionNote}" Classes="caption" TextWrapping="Wrap"
                                   IsVisible="{Binding HasEvolutionNote}" />
                        <TextBlock Text="{Binding OtherEvolutionsText}" Classes="caption"
                                   TextWrapping="Wrap" IsVisible="{Binding HasOtherEvolutions}" />
                      </StackPanel>

                      <ItemsControl ItemsSource="{Binding UpcomingMoves}"
                                    IsVisible="{Binding HasUpcomingMoves}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:UpcomingMoveRow">
                            <Grid ColumnDefinitions="62,165,95,*" Margin="0,0,0,7" ColumnSpacing="10">
                              <TextBlock Text="{Binding Level}" FontSize="14.5" FontWeight="SemiBold"
                                         Classes="numeric" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14.5"
                                         VerticalAlignment="Center" />
                              <Border Grid.Column="2" Background="{Binding Brush}" CornerRadius="4"
                                      Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12.5" />
                              </Border>
                              <TextBlock Grid.Column="3" Text="{Binding Distance}" Classes="caption"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding IsEgg}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Still an egg" Classes="section" />
                      <TextBlock Text="{Binding EggProgressText}" FontSize="15" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="It takes up a party slot but cannot battle, so it is left out of the team's coverage and strength. Its species, moves and stats stay hidden until it hatches — same as in the game." />
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding HasRecommendation}">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Recommendation" Classes="section" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Show the best set" Classes="primary"
                                Command="{Binding ToggleBuildCommand}" />
                      </Grid>

                      <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Text="Role" Classes="caption" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding RoleText}" FontSize="14.5" />
                          <TextBlock Text="{Binding RoleReason}" Classes="caption" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Nature" Classes="caption" />
                        <StackPanel Grid.Row="1" Grid.Column="1">
                          <TextBlock Text="{Binding NatureText}" FontSize="14.5" />
                          <TextBlock Text="{Binding NatureNote}" Classes="caption" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Effort values" Classes="caption" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                          <TextBlock Text="{Binding EffortValueText}" FontSize="14.5" />
                          <TextBlock Text="{Binding ProjectedStatsText}" Classes="caption"
                                     IsVisible="{Binding HasProjectedStats}" />
                        </StackPanel>
                      </Grid>

                      <StackPanel Spacing="10" IsVisible="{Binding ShowBuild}">
                        <Border Height="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                        <TextBlock Text="Best set" Classes="section" />

                        <ItemsControl ItemsSource="{Binding BuildMoves}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BuildMoveRow">
                              <Grid ColumnDefinitions="165,95,*" RowDefinitions="Auto,Auto"
                                    Margin="0,0,0,12" ColumnSpacing="10">
                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Background="{Binding Brush}" CornerRadius="4"
                                        Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                  <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12.5" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Role}" FontSize="12.5"
                                           FontWeight="SemiBold" Opacity="0.75" />

                                <!-- How to get it. Telling someone to run Dig without saying
                                     it means finding a TM is half an answer. -->
                                <TextBlock Grid.Row="1" Text="{Binding Source}" FontSize="12.5"
                                           Foreground="#7FAAF0" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding Reason}" Classes="caption"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The whole pool the four were picked from. A chosen move is
                             ticked and fully lit; the rest stay legible but dimmer. -->
                        <TextBlock Text="{Binding CandidatesHeading}" Classes="section"
                                   IsVisible="{Binding HasCandidates}" />
                        <ItemsControl ItemsSource="{Binding Candidates}"
                                      IsVisible="{Binding HasCandidates}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CandidateMoveRow">
                              <Grid ColumnDefinitions="18,150,88,*,auto" ColumnSpacing="9"
                                    Margin="0,0,0,5" Opacity="{Binding Fade}">
                                <TextBlock Text="{Binding Marker}" FontSize="12.5"
                                           Foreground="#4E9A3F" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13.5"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2" Background="{Binding Brush}" CornerRadius="4"
                                        Padding="6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding Type}" Foreground="White" FontSize="11.5" />
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="12.5"
                                           Foreground="#7FAAF0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{Binding Availability}"
                                           Classes="caption" VerticalAlignment="Center" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Held item" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                              <TextBlock Text="{Binding}" Classes="caption" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding PresetText}" IsVisible="{Binding HasPreset}"
                                   Classes="caption" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding ShowsBattleData}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Base stats" Classes="section" />
                      <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StatRow">
                            <Grid ColumnDefinitions="110,44,*,52,44,44" ColumnSpacing="10" Margin="0,3">
                              <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Base}" FontSize="13.5"
                                         Classes="numeric" VerticalAlignment="Center" />
                              <Grid Grid.Column="2" Height="7" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="{Binding Filled}" />
                                  <ColumnDefinition Width="{Binding Empty}" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Background="{Binding Brush}" />
                                <Border Grid.Column="1" CornerRadius="4" Opacity="0.2"
                                        Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                              </Grid>
                              <TextBlock Grid.Column="3" Text="{Binding Current}" FontSize="13.5"
                                         FontWeight="SemiBold" Classes="numeric" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding Iv}" FontSize="12.5"
                                         Classes="muted numeric" VerticalAlignment="Center"
                                         ToolTip.Tip="Individual value" />
                              <TextBlock Grid.Column="5" Text="{Binding Ev}" FontSize="12.5"
                                         Classes="muted numeric" VerticalAlignment="Center"
                                         ToolTip.Tip="Effort value" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="110,44,*,52,44,44" ColumnSpacing="10">
                        <TextBlock Grid.Column="1" Text="base" Classes="caption" />
                        <TextBlock Grid.Column="3" Text="now" Classes="caption" />
                        <TextBlock Grid.Column="4" Text="IV" Classes="caption" />
                        <TextBlock Grid.Column="5" Text="EV" Classes="caption" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding ShowsBattleData}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Matchups" Classes="section" />
                      <TextBlock Text="Weak to" Classes="caption" IsVisible="{Binding HasWeaknesses}" />
                      <ItemsControl ItemsSource="{Binding Weaknesses}" IsVisible="{Binding HasWeaknesses}"
                                    ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />

                      <TextBlock Text="Resists" Classes="caption" IsVisible="{Binding HasResistances}" />
                      <ItemsControl ItemsSource="{Binding Resistances}" IsVisible="{Binding HasResistances}"
                                    ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />

                      <!-- Immunity is not a strong resistance, it is a different plan:
                           nothing lands at all, which is what a free switch-in is made of. -->
                      <TextBlock Text="Immune to" Classes="caption" IsVisible="{Binding HasImmunities}" />
                      <ItemsControl ItemsSource="{Binding Immunities}" IsVisible="{Binding HasImmunities}"
                                    ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding ShowsBattleData}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Known moves" Classes="section" />
                      <ItemsControl ItemsSource="{Binding Moves}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MoveRow">
                            <Grid ColumnDefinitions="180,110,*" Margin="0,3">
                              <TextBlock Text="{Binding Name}" FontSize="13.5" />
                              <Border Grid.Column="1" Background="{Binding Brush}" CornerRadius="4"
                                      Padding="7,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12.5" />
                              </Border>
                              <TextBlock Grid.Column="2" Text="{Binding Pp}" FontSize="13.5"
                                         Classes="muted numeric" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Panel>
      </ScrollViewer>
          </Grid>
        </Panel>
      </Grid>

      <!-- With no bridge there is deliberately no identity header, tab strip or party rail. -->
      <Panel Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource TabBg}"
             IsVisible="{Binding !IsConnected}">
        <Border Background="{StaticResource Halftone}" IsHitTestVisible="False" />
        <ScrollViewer>
          <views:BridgeView Margin="36,34,36,42" HorizontalAlignment="Center" />
        </ScrollViewer>
      </Panel>
    </Grid>
  </Border>
</Window>
