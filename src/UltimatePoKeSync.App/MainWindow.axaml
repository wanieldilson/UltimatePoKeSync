<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UltimatePoKeSync.App.ViewModels"
        xmlns:sys="using:System"
        x:Class="UltimatePoKeSync.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="UltimatePoKeSync"
        Icon="avares://UltimatePoKeSync/Assets/app-icon.png"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="600">

  <Window.Resources>
    <!--
      A palette rather than Fluent's defaults. Three surface levels instead of one flat
      grey, all biased slightly to blue so the neutrals read as chosen; the accent is the
      same blue the type chart gives Water, which keeps the app and its subject in one
      family. Per-Pokémon colour comes from the type and is applied at the tile, so the
      chrome never competes with it.
    -->
    <Color x:Key="Surface0Color">#0E1116</Color>
    <SolidColorBrush x:Key="Surface0" Color="#0E1116" />
    <SolidColorBrush x:Key="Surface1" Color="#161A21" />
    <SolidColorBrush x:Key="Surface2" Color="#1E242C" />
    <SolidColorBrush x:Key="Surface3" Color="#28303A" />
    <SolidColorBrush x:Key="Line" Color="#262E39" />
    <SolidColorBrush x:Key="Ink" Color="#E9EDF3" />
    <SolidColorBrush x:Key="InkMuted" Color="#94A0B0" />
    <SolidColorBrush x:Key="Accent" Color="#4C8DF6" />
    <SolidColorBrush x:Key="AccentSoft" Color="#1B2B45" />

    <DataTemplate x:Key="ChipTemplate" x:DataType="vm:TypeChip">
      <Border Background="{Binding Brush}" CornerRadius="999" Padding="10,3" Margin="0,0,6,6"
              ToolTip.Tip="{Binding Detail}">
        <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12.5" FontWeight="SemiBold" />
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="ChipPanel">
      <WrapPanel />
    </ItemsPanelTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Window">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="{StaticResource Surface0}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <!-- Cards sit one level above the ground and carry a hairline, which is what stops a
         dark interface reading as one undifferentiated sheet. -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource Surface1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="LetterSpacing" Value="0.09" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
    </Style>

    <Style Selector="TextBlock.numeric">
      <Setter Property="FontFeatures" Value="tnum" />
    </Style>

    <!-- Buttons: a quiet pill by default, filled only where the action is the point of
         the panel it sits in. -->
    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="BorderBrush" Value="{StaticResource Line}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface1}" />
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5F9BF8" />
      <Setter Property="BorderBrush" Value="#5F9BF8" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- The profile is two named modes, not an on/off state, so it reads as a segmented
         control rather than as a switch whose meaning depends on which way it points. -->
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
    <Style Selector="Button.segment.on">
      <Setter Property="Background" Value="{StaticResource Accent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Surface3}" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style Selector="Button.segment.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5F9BF8" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected Border.tile">
      <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="ListBoxItem:pointerover Border.tile">
      <Setter Property="BorderBrush" Value="{StaticResource Surface3}" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style Selector="ProgressBar">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="Background" Value="{StaticResource Surface2}" />
      <Setter Property="CornerRadius" Value="999" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Header: what it is, what it is connected to, and which profile is answering. -->
    <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource SystemControlBackgroundListLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Image Source="avares://UltimatePoKeSync/Assets/app-icon.png" Width="40" Height="40"
                 VerticalAlignment="Center" />
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="UltimatePoKeSync" Classes="title" />
            <TextBlock Text="{Binding GameText}" Classes="caption" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">

          <!-- State as a pill: a dot alone is a decoration, a dot in a chip is a status. -->
          <Border Background="{StaticResource Surface1}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="999" Padding="12,6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding ConnectionBrush}" />
              <TextBlock Text="{Binding ConnectionText}" FontSize="13.5" VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <Button Content="Bridge script" Command="{Binding RevealScriptCommand}"
                  ToolTip.Tip="{Binding ScriptPath}" />
          <Button Name="CopyHeaderPathButton" Content="Copy path"
                  ToolTip.Tip="{Binding ScriptPath}" />

          <Border Background="{StaticResource Surface1}" BorderBrush="{StaticResource Line}"
                  BorderThickness="1" CornerRadius="999" Padding="3">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Content="Playthrough" Classes="segment" Classes.on="{Binding !IsCompetitive}"
                      Command="{Binding ChooseProfileCommand}" CommandParameter="playthrough"
                      ToolTip.Tip="Answers for the story: what this Pokémon can reach now." />
              <Button Content="Competitive" Classes="segment" Classes.on="{Binding IsCompetitive}"
                      Command="{Binding ChooseProfileCommand}" CommandParameter="competitive"
                      ToolTip.Tip="Answers for battling: every move it can legally end up with." />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Setup: shown until the bridge answers, and not a moment longer. -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding ShowSetup}">
      <StackPanel MaxWidth="720" Margin="24,32" Spacing="18" HorizontalAlignment="Center">
        <TextBlock Text="Connect the emulator" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Classes="muted"
                   Text="{Binding PlatformName, StringFormat='Setting up on {0}. mGBA cannot load a script from the command line, so this part is manual — once, then it just works.'}" />

        <ItemsControl ItemsSource="{Binding SetupSteps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <Border Classes="card" Margin="0,0,0,8">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Classes="card" Background="#33D9602E" IsVisible="{Binding IsTranslocated}">
          <TextBlock Text="{Binding TranslocationWarning}" TextWrapping="Wrap" />
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="Script to load" Classes="section" />
            <SelectableTextBlock Text="{Binding ScriptPath}" FontFamily="monospace"
                                 TextWrapping="Wrap" FontSize="13.5" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="CopyPathButton" Content="Copy path" />
              <Button Content="{Binding RevealButtonText}" Command="{Binding RevealScriptCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="{Binding PortHelp}" Classes="muted" FontSize="13.5" />
        <TextBlock Text="{Binding AnalysisError}" IsVisible="{Binding HasAnalysisError}"
                   Foreground="#D9602E" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <!-- Connected, read, and carrying nothing. Distinct from not being connected, which
         is what this used to be indistinguishable from. -->
    <StackPanel Grid.Row="1" IsVisible="{Binding HasEmptyParty}" Spacing="10"
                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
      <TextBlock Text="No Pokémon in the party" FontSize="20" FontWeight="SemiBold"
                 HorizontalAlignment="Center" />
      <TextBlock Classes="muted" TextAlignment="Center"
                 Text="The bridge is connected and the save was read: there is simply nothing in the team yet. Catch or withdraw one and it appears here on its own." />
      <TextBlock Text="{Binding GameText}" Classes="caption" HorizontalAlignment="Center" />
    </StackPanel>

    <!-- Dashboard. -->
    <Grid Grid.Row="1" IsVisible="{Binding HasTeam}" ColumnDefinitions="230,*" Margin="16,16,16,16">

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ListBox ItemsSource="{Binding Slots}" SelectedItem="{Binding SelectedSlot}"
                   Background="Transparent" BorderThickness="0" Padding="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PokemonSlotViewModel">
                <Border Classes="tile" Background="{Binding TileBrush}">
                  <StackPanel Spacing="7">

                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Panel Width="52" Height="52">
                        <!-- The coloured box is the ground the sprite lands on, so a game
                             we cannot read still shows something. -->
                        <Border CornerRadius="6" Background="{Binding PrimaryBrush}"
                                IsVisible="{Binding !HasSprite}">
                          <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                     FontSize="14.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Sprite}" IsVisible="{Binding HasSprite}"
                               RenderOptions.BitmapInterpolationMode="None"
                               Stretch="Uniform" />
                      </Panel>

                      <StackPanel Grid.Column="1" Margin="9,0,0,0" Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SpeciesName}" FontWeight="SemiBold" FontSize="14.5"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding NicknameText}" IsVisible="{Binding HasNickname}"
                                   Classes="muted" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TypeText}" Classes="muted" FontSize="12.5" />
                      </StackPanel>

                      <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding LevelText}" FontSize="12.5" HorizontalAlignment="Right" />
                        <TextBlock Text="✦" IsVisible="{Binding IsShiny}" FontSize="13.5"
                                   Foreground="#C9A227" HorizontalAlignment="Right"
                                   ToolTip.Tip="Shiny" />
                      </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="7"
                          IsVisible="{Binding ShowsBattleData}">
                      <Grid Height="5" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="{Binding HpFilled}" />
                          <ColumnDefinition Width="{Binding HpRemaining}" />
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="3" Background="{Binding HpBrush}" />
                        <Border Grid.Column="1" CornerRadius="3" Opacity="0.25"
                                Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                      </Grid>
                      <TextBlock Grid.Column="1" Text="{Binding HpText}" FontSize="12"
                                 Classes="muted" VerticalAlignment="Center" />
                      <Border Grid.Column="2" Background="{Binding StatusBrush}" CornerRadius="3"
                              Padding="5,1" IsVisible="{Binding HasStatus}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11"
                                   FontWeight="SemiBold" />
                      </Border>
                    </Grid>

                    <TextBlock Text="{Binding HeldItemText}" IsVisible="{Binding HasHeldItem}"
                               Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ItemsControl ItemsSource="{Binding EmptySlots}" IsVisible="{Binding HasEmptySlots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sys:Int32">
                <Border CornerRadius="14" Padding="12" Margin="0,0,0,8" Height="72"
                        BorderThickness="1" BorderBrush="{StaticResource Line}"
                        Background="#0B0E12">
                  <TextBlock Text="empty" Classes="caption" Opacity="0.5"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <ScrollViewer Grid.Column="1" Margin="16,0,0,0">
        <Panel>

          <!-- No selection: the whole party. -->
          <StackPanel Spacing="14" IsVisible="{Binding ShowTeamPanel}">

            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Team strength" Classes="section" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" FontSize="29" FontWeight="SemiBold" Classes="numeric"
                             Text="{Binding StrengthScore, StringFormat='{}{0}/100'}" />
                </Grid>
                <ProgressBar Value="{Binding StrengthScore}" Maximum="100" Height="6" />
                <TextBlock Text="{Binding StrengthHeadline}" Classes="muted" FontSize="13.5" />

                <ItemsControl ItemsSource="{Binding StrengthFactors}" Margin="0,6,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StrengthRow">
                      <Grid ColumnDefinitions="150,70,*" Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13.5"
                                   Classes="muted numeric" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Explanation}" FontSize="13.5"
                                   Classes="muted" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Defending" Classes="section" />
                <TextBlock Text="Weak to" Classes="caption" />
                <ItemsControl ItemsSource="{Binding TeamWeaknesses}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                <TextBlock Text="Neutral" Classes="caption" />
                <ItemsControl ItemsSource="{Binding TeamNeutral}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                <TextBlock Text="Resisted or immune" Classes="caption" />
                <ItemsControl ItemsSource="{Binding TeamResisted}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Text="Attacking" Classes="section" />
                <TextBlock Text="Hit super effectively" Classes="caption" />
                <TextBlock Text="nothing yet" Classes="muted" FontSize="12.5" Opacity="0.4"
                           IsVisible="{Binding !HasSuperEffective}" />
                <ItemsControl ItemsSource="{Binding TeamSuperEffective}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                <TextBlock Text="No super-effective answer" Classes="caption" />
                <TextBlock Text="every type is covered" Classes="muted" FontSize="12.5" Opacity="0.4"
                           IsVisible="{Binding !HasUnanswered}" />
                <ItemsControl ItemsSource="{Binding TeamUnanswered}" ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
              </StackPanel>
            </Border>

          </StackPanel>

          <!-- A slot is selected: the Pokémon, the way a Pokédex would lay it out. -->
          <ContentControl IsVisible="{Binding !ShowTeamPanel}" Content="{Binding SelectedSlot}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:PokemonSlotViewModel">
                <StackPanel Spacing="14">

                  <!-- Hero: the sprite at a size worth looking at, tinted with the
                       Pokémon's own type so each one feels like its own page. -->
                  <Border CornerRadius="12" Padding="20" Background="{Binding TileBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Panel Width="112" Height="112" VerticalAlignment="Top">
                        <Border CornerRadius="10" Background="{Binding PrimaryBrush}"
                                IsVisible="{Binding !HasSprite}">
                          <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                     FontSize="33" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding Sprite}" IsVisible="{Binding HasSprite}"
                               RenderOptions.BitmapInterpolationMode="None" Stretch="Uniform" />
                      </Panel>

                      <StackPanel Grid.Column="1" Margin="20,2,0,0" Spacing="9">
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding SpeciesName}" FontSize="29" FontWeight="Bold" />
                          <TextBlock Text="{Binding NicknameText}" IsVisible="{Binding HasNickname}"
                                     Classes="muted" FontSize="14.5" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <ItemsControl ItemsSource="{Binding TypeChips}"
                                        ItemTemplate="{StaticResource ChipTemplate}"
                                        ItemsPanel="{StaticResource ChipPanel}" />
                          <TextBlock Text="✦ shiny" IsVisible="{Binding IsShiny}" FontSize="12.5"
                                     Foreground="#C9A227" VerticalAlignment="Center" />
                        </StackPanel>

                        <Grid ColumnDefinitions="220,Auto,Auto" ColumnSpacing="10"
                              IsVisible="{Binding ShowsBattleData}">
                          <Grid Height="8" Width="220" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding HpFilled}" />
                              <ColumnDefinition Width="{Binding HpRemaining}" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Background="{Binding HpBrush}" />
                            <Border Grid.Column="1" CornerRadius="4" Opacity="0.25"
                                    Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding HpText}" FontSize="13.5"
                                     Classes="numeric" VerticalAlignment="Center" />
                          <Border Grid.Column="2" Background="{Binding StatusBrush}" CornerRadius="3"
                                  Padding="6,1" IsVisible="{Binding HasStatus}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11.5"
                                       FontWeight="SemiBold" />
                          </Border>
                        </Grid>

                        <TextBlock Classes="caption" IsVisible="{Binding ShowsBattleData}">
                          <Run Text="{Binding LevelText}" />
                          <Run Text="·" />
                          <Run Text="{Binding NatureName}" />
                          <Run Text="·" />
                          <Run Text="{Binding AbilityText}" />
                          <Run Text="·" />
                          <Run Text="{Binding HeldItemText}" />
                        </TextBlock>
                      </StackPanel>

                      <Button Grid.Column="2" Content="Back to team" VerticalAlignment="Top"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ClearSelectionCommand}" />
                    </Grid>
                  </Border>

                  <!-- What the next few levels bring. Above the best set on purpose: it is
                       the decision a player in the middle of a story is actually making. -->
                  <Border Classes="card" IsVisible="{Binding HasProgress}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Coming up" Classes="section" />

                      <StackPanel Spacing="3" IsVisible="{Binding HasEvolution}">
                        <TextBlock Text="{Binding EvolutionText}" FontSize="15" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EvolutionNote}" Classes="caption" TextWrapping="Wrap"
                                   IsVisible="{Binding HasEvolutionNote}" />
                        <TextBlock Text="{Binding OtherEvolutionsText}" Classes="caption"
                                   TextWrapping="Wrap" IsVisible="{Binding HasOtherEvolutions}" />
                      </StackPanel>

                      <ItemsControl ItemsSource="{Binding UpcomingMoves}"
                                    IsVisible="{Binding HasUpcomingMoves}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:UpcomingMoveRow">
                            <Grid ColumnDefinitions="62,165,95,*" Margin="0,0,0,7" ColumnSpacing="10">
                              <TextBlock Text="{Binding Level}" FontSize="14.5" FontWeight="SemiBold"
                                         Classes="numeric" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14.5"
                                         VerticalAlignment="Center" />
                              <Border Grid.Column="2" Background="{Binding Brush}" CornerRadius="4"
                                      Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12.5" />
                              </Border>
                              <TextBlock Grid.Column="3" Text="{Binding Distance}" Classes="caption"
                                         VerticalAlignment="Center" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding IsEgg}">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Still an egg" Classes="section" />
                      <TextBlock Text="{Binding EggProgressText}" FontSize="15" />
                      <TextBlock Classes="muted" TextWrapping="Wrap"
                                 Text="It takes up a party slot but cannot battle, so it is left out of the team's coverage and strength. Its species, moves and stats stay hidden until it hatches — same as in the game." />
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding HasRecommendation}">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Recommendation" Classes="section" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Show the best set" Classes="primary"
                                Command="{Binding ToggleBuildCommand}" />
                      </Grid>

                      <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <TextBlock Text="Role" Classes="caption" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding RoleText}" FontSize="14.5" />
                          <TextBlock Text="{Binding RoleReason}" Classes="caption" />
                        </StackPanel>

                        <TextBlock Grid.Row="1" Text="Nature" Classes="caption" />
                        <StackPanel Grid.Row="1" Grid.Column="1">
                          <TextBlock Text="{Binding NatureText}" FontSize="14.5" />
                          <TextBlock Text="{Binding NatureNote}" Classes="caption" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="Effort values" Classes="caption" />
                        <StackPanel Grid.Row="2" Grid.Column="1">
                          <TextBlock Text="{Binding EffortValueText}" FontSize="14.5" />
                          <TextBlock Text="{Binding ProjectedStatsText}" Classes="caption"
                                     IsVisible="{Binding HasProjectedStats}" />
                        </StackPanel>
                      </Grid>

                      <StackPanel Spacing="10" IsVisible="{Binding ShowBuild}">
                        <Border Height="1" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
                        <TextBlock Text="Best set" Classes="section" />

                        <ItemsControl ItemsSource="{Binding BuildMoves}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BuildMoveRow">
                              <Grid ColumnDefinitions="165,95,*" RowDefinitions="Auto,Auto"
                                    Margin="0,0,0,12" ColumnSpacing="10">
                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" />
                                <Border Grid.Column="1" Background="{Binding Brush}" CornerRadius="4"
                                        Padding="7,1" HorizontalAlignment="Left" VerticalAlignment="Top">
                                  <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12.5" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Role}" FontSize="12.5"
                                           FontWeight="SemiBold" Opacity="0.75" />

                                <!-- How to get it. Telling someone to run Dig without saying
                                     it means finding a TM is half an answer. -->
                                <TextBlock Grid.Row="1" Text="{Binding Source}" FontSize="12.5"
                                           Foreground="#7FAAF0" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding Reason}" Classes="caption"
                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Also considered" Classes="section"
                                   IsVisible="{Binding HasAlternatives}" />
                        <ItemsControl ItemsSource="{Binding Alternatives}"
                                      IsVisible="{Binding HasAlternatives}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                              <TextBlock Text="{Binding}" Classes="caption" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Held item" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:String">
                              <TextBlock Text="{Binding}" Classes="caption" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding PresetText}" IsVisible="{Binding HasPreset}"
                                   Classes="caption" />
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding ShowsBattleData}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Base stats" Classes="section" />
                      <ItemsControl ItemsSource="{Binding Stats}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:StatRow">
                            <Grid ColumnDefinitions="110,44,*,52,44,44" ColumnSpacing="10" Margin="0,3">
                              <TextBlock Text="{Binding Name}" FontSize="13.5" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="1" Text="{Binding Base}" FontSize="13.5"
                                         Classes="numeric" VerticalAlignment="Center" />
                              <Grid Grid.Column="2" Height="7" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="{Binding Filled}" />
                                  <ColumnDefinition Width="{Binding Empty}" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="4" Background="{Binding Brush}" />
                                <Border Grid.Column="1" CornerRadius="4" Opacity="0.2"
                                        Background="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                              </Grid>
                              <TextBlock Grid.Column="3" Text="{Binding Current}" FontSize="13.5"
                                         FontWeight="SemiBold" Classes="numeric" VerticalAlignment="Center" />
                              <TextBlock Grid.Column="4" Text="{Binding Iv}" FontSize="12.5"
                                         Classes="muted numeric" VerticalAlignment="Center"
                                         ToolTip.Tip="Individual value" />
                              <TextBlock Grid.Column="5" Text="{Binding Ev}" FontSize="12.5"
                                         Classes="muted numeric" VerticalAlignment="Center"
                                         ToolTip.Tip="Effort value" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="110,44,*,52,44,44" ColumnSpacing="10">
                        <TextBlock Grid.Column="1" Text="base" Classes="caption" />
                        <TextBlock Grid.Column="3" Text="now" Classes="caption" />
                        <TextBlock Grid.Column="4" Text="IV" Classes="caption" />
                        <TextBlock Grid.Column="5" Text="EV" Classes="caption" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding ShowsBattleData}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Matchups" Classes="section" />
                      <TextBlock Text="Weak to" Classes="caption" IsVisible="{Binding HasWeaknesses}" />
                      <ItemsControl ItemsSource="{Binding Weaknesses}" IsVisible="{Binding HasWeaknesses}"
                                    ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />

                      <TextBlock Text="Resists" Classes="caption" IsVisible="{Binding HasResistances}" />
                      <ItemsControl ItemsSource="{Binding Resistances}" IsVisible="{Binding HasResistances}"
                                    ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />

                      <!-- Immunity is not a strong resistance, it is a different plan:
                           nothing lands at all, which is what a free switch-in is made of. -->
                      <TextBlock Text="Immune to" Classes="caption" IsVisible="{Binding HasImmunities}" />
                      <ItemsControl ItemsSource="{Binding Immunities}" IsVisible="{Binding HasImmunities}"
                                    ItemTemplate="{StaticResource ChipTemplate}" ItemsPanel="{StaticResource ChipPanel}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="card" IsVisible="{Binding ShowsBattleData}">
                    <StackPanel Spacing="10">
                      <TextBlock Text="Known moves" Classes="section" />
                      <ItemsControl ItemsSource="{Binding Moves}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:MoveRow">
                            <Grid ColumnDefinitions="180,110,*" Margin="0,3">
                              <TextBlock Text="{Binding Name}" FontSize="13.5" />
                              <Border Grid.Column="1" Background="{Binding Brush}" CornerRadius="4"
                                      Padding="7,1" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Type}" Foreground="White" FontSize="12.5" />
                              </Border>
                              <TextBlock Grid.Column="2" Text="{Binding Pp}" FontSize="13.5"
                                         Classes="muted numeric" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Panel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
