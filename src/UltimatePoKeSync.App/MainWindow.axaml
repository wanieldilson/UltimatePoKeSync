<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UltimatePoKeSync.App.MainWindow"
        Title="UltimatePoKeSync"
        Width="1000" Height="700"
        MinWidth="720" MinHeight="480">

  <!-- Placeholder. The real dashboard lands with milestone M7. -->
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
    <TextBlock Text="UltimatePoKeSync"
               FontSize="28" FontWeight="SemiBold"
               HorizontalAlignment="Center" />
    <TextBlock Text="The dashboard lands with milestone M7."
               Opacity="0.7" HorizontalAlignment="Center" />
    <TextBlock Text="For now, use the CLI:  dotnet run --project src/UltimatePoKeSync.Cli"
               Opacity="0.7" FontFamily="monospace" HorizontalAlignment="Center" />
  </StackPanel>

</Window>
