<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Avalonia UI. Runs natively on Windows, Linux and macOS including Apple Silicon,
    unlike WPF. See D-011. The dashboard is milestone M7 (D-028).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>UltimatePoKeSync</AssemblyName>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>

    <!--
      The release workflow overrides this with the tag it was built from. A build made
      anywhere else keeps 0.0.0, which the update check reads as "not a release" and stays
      quiet about: a developer running from source is not somebody to nag. See D-056.
    -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the tests can reach the connection-state ranking, which is worth checking
         against the real thing rather than against a copy of it. -->
    <InternalsVisibleTo Include="UltimatePoKeSync.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UltimatePoKeSync.Contracts\UltimatePoKeSync.Contracts.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Providers.MGba\UltimatePoKeSync.Providers.MGba.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Providers.MelonDs\UltimatePoKeSync.Providers.MelonDs.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Parsing\UltimatePoKeSync.Parsing.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Session\UltimatePoKeSync.Session.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.Analysis\UltimatePoKeSync.Analysis.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.GameData\UltimatePoKeSync.GameData.csproj" />
    <ProjectReference Include="..\UltimatePoKeSync.GameData.Learnsets\UltimatePoKeSync.GameData.Learnsets.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window and taskbar icon. The .ico above is the one Windows stamps on the exe,
         and the .icns is built from the same artwork by build/make-icns.sh. -->
    <AvaloniaResource Include="Assets/app-icon.png" />
    <AvaloniaResource Include="Assets/upsync-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bungee, Nunito and DM Mono, under the SIL Open Font License. The one design
         dependency the redesign adds, and the only files in this repository that are not
         ours: see THIRD_PARTY_NOTICES.md. -->
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <AvaloniaResource Include="Theme.axaml" />
    <AvaloniaResource Include="Styles.axaml" />
    <AvaloniaResource Include="Assets/halftone.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The bridge script ships next to the executable. A user who downloaded a release has
      no repository to hunt through, and the setup screen needs a real path to point at.
    -->
    <None Include="..\..\emulator-scripts\mgba\ups_bridge.lua"
          Link="emulator-scripts\ups_bridge.lua"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
